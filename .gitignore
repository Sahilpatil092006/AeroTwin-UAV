# ==========================================
# AeroTwin-UAV - Git Ignore Configuration
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/build/
.eslintcache

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# SQLite & Databases
*.sqlite
*.sqlite3
*.db
*.db-journal

# Data & Datasets (Keep directories via .gitkeep, ignore large generated datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/simulated/*
!data/simulated/.gitkeep
data/synthetic/raw/*
!data/synthetic/raw/.gitkeep
data/synthetic/processed/*
!data/synthetic/processed/.gitkeep
*.csv
*.parquet
*.h5
*.hdf5
!data/synthetic/*.csv
!data/synthetic/raw/*.csv

# Machine Learning Artifacts & Weights
models/saved_models/*
!models/saved_models/.gitkeep
models/checkpoints/*
!models/checkpoints/.gitkeep
*.pkl
*.joblib
*.onnx
*.pt
*.pth
!models/fault_classifier.joblib
!models/fault_classifier_metadata.json
!models/anomaly_detector.joblib
!models/anomaly_detector_metadata.json
!models/rul_model.joblib
!models/rul_model_metadata.json

# Telemetry Logs & Runtime Outputs
logs/
*.log
*.log.*
